# Copy this file to ".env" (never commit the real one) and fill in the values.
# Used by the API when run locally, by the tests, and by docker compose.

# --- Database ---
# Local development: a PostgreSQL you run yourself, with an empty database called "retrolive".
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/retrolive
# The tests empty their tables, so this database MUST have a name ending in "_test".
TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/retrolive_test

# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Browser origins allowed to call the API (comma-separated) ---
CORS_ORIGIN=http://localhost:5173

# --- Port of the API ---
PORT=4000

# --- AI summary (Google Gemini, free tier). Get a key at https://aistudio.google.com/apikey
# Leave the key empty to run without AI: everything else works and the summary button just says it is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- docker compose only ---
COMPOSE_DB_PASSWORD=retrolive
WEB_PORT=8080
API_PORT=4000
